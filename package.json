{
  "name": "carbonboard",
  "version": "1.0.0",
  "description": "Windows soundboard app with virtual audio cable support",
  "main": "electron/main.js",
  "author": "CarbonBoard",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev -p 3456",
    "dev:electron": "wait-on http://localhost:3456 && electron .",
    "build": "next build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "better-sqlite3": "^11.6.0",
    "electron-store": "^8.2.0",
    "uuid": "^10.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "next": "^14.2.21",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.carbonboard.app",
    "productName": "CarbonBoard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*.js",
      "electron/**/*.js.map",
      "out/**/*",
      "build/**/*",
      "shared/**/*",
      "node_modules/**/*",
      "package.json",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/web-remote.html",
        "to": "web-remote.html"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@ricky0123/**/*",
      "node_modules/onnxruntime-web/**/*",
      "out/vad/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
