{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "CarbonBoard",
  "Version": "1.1.0.0",
  "Author": "Carbon",
  "UUID": "dev.carbon.carbonboard",
  "Description": "Controls for the CarbonBoard soundboard running on this PC.",
  "Category": "CarbonBoard",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "disabled"
  },
  "Actions": [
    {
      "UUID": "dev.carbon.carbonboard.micmute",
      "Name": "Mic Mute",
      "Icon": "imgs/action",
      "Tooltip": "Mute or unmute the microphone CarbonBoard is passing through, whichever one that is.",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/live",
          "Name": "Live"
        },
        {
          "Image": "imgs/muted",
          "Name": "Muted"
        }
      ]
    },
    {
      "UUID": "dev.carbon.carbonboard.micboostdown",
      "Name": "Mic Boost Down",
      "Icon": "imgs/action-down",
      "Tooltip": "Turn the microphone down by 10%. The key shows the current level.",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/boost-down"
        }
      ]
    },
    {
      "UUID": "dev.carbon.carbonboard.micboostup",
      "Name": "Mic Boost Up",
      "Icon": "imgs/action-up",
      "Tooltip": "Turn the microphone up by 10%, to 200% at most. The key shows the current level.",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/boost-up"
        }
      ]
    }
  ]
}
